{
  "name": "@talestudio/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "studio": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@talestudio/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
