{
  "name": "talestudio",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@talestudio/web --filter=@talestudio/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @talestudio/db generate",
    "db:migrate": "pnpm --filter @talestudio/db migrate",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "vitest": "^3.2.4"
  }
}
