# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32+-random-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (docker compose: pnpm infra:up) ─────────
DATABASE_URL=postgres://talestudio:talestudio@localhost:5432/talestudio

# ── Object storage (LocalStack locally, S3 in prod) ───────
S3_BUCKET=talestudio
S3_REGION=us-east-1
# leave empty on AWS
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# CloudFront URL in prod (terraform output cdn_base_url)
CDN_BASE_URL=

# ── Orchestration ────────────────────────────────────
# Leave TEMPORAL_ADDRESS empty to run the pipeline in-process (dev only, no retries).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=episodes

# ── AI providers ─────────────────────────────────────
# mock = free deterministic placeholders. live = real APIs. Per step: AI_SCRIPT, AI_IMAGE, AI_VIDEO, AI_SPEECH, AI_LIPSYNC
AI_PROVIDERS=mock
# Simulated per-call latency for mock providers (ms)
AI_MOCK_LATENCY_MS=400
# RodiumAI (primary route for every step except lip-sync). Billed in RODI (1 RODI = 1 XOF).
RODIUM_API_KEY=
RODIUM_BASE_URL=https://api.rodiumai.io
RODIUM_SCRIPT_MODEL=anthropic/claude-opus-5-5
RODIUM_IMAGE_MODEL=bytedance/seedream-5-0-lite
RODIUM_VIDEO_MODEL=bytedance/seedance-1-0-pro
RODIUM_SPEECH_MODEL=openai/gpt-4o-mini-tts
RODIUM_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe-diarize
# XOF per USD, used to convert RODI costs
RODI_PER_USD=565

# Direct providers: fallback when Rodium fails (down, error, insufficient balance). Leave a key empty to
# disable that fallback. FAL_KEY is still required for lip-sync.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_CONSISTENT_IMAGE_MODEL=fal-ai/flux-pulid
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync
ELEVENLABS_API_KEY=

# Per-step switches also exist for AI_TRANSCRIBE, AI_HIGHLIGHTS, AI_FACTCHECK
FAL_WHISPER_MODEL=fal-ai/whisper
# FFmpeg: the worker uses the ffmpeg-static binary unless FFMPEG_PATH is set
FFMPEG_PATH=

# ── Email (invitations). Without a key, invite links are shown to copy instead. ──
RESEND_API_KEY=
EMAIL_FROM=TaleStudio <noreply@talestudio.app>

# ── Wallet top-ups: CinetPay (Mobile Money + cards, FCFA) ──
# Merchant dashboard → Intégrations. Notifications go to $NEXT_PUBLIC_APP_URL/api/payments/cinetpay/notify,
# so the app URL must be publicly reachable for them (the return page also settles payments).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Secret key used to verify the x-token HMAC on notifications
CINETPAY_SECRET_KEY=
# ALL, MOBILE_MONEY, CREDIT_CARD or WALLET
CINETPAY_CHANNELS=ALL

# ── SEO ──────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL must be the real public domain in production: canonical URLs, sitemap, hreflang and share
# images are built from it. Verification codes from Google Search Console and Bing Webmaster Tools (meta tag method).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
